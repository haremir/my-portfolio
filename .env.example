GROQ_API_KEY=your_key_here
ADMIN_PASSWORD=admin123

# Reflex dev hot-reload: exclude runtime data dirs (chat logs, summaries).
REFLEX_HOT_RELOAD_EXCLUDE_PATHS=data

# Groq token optimization (optional overrides)
# GROQ_CHAT_MODEL_FAST=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_CHAT_MODEL_DEEP=llama-3.3-70b-versatile
# GROQ_CHAT_ROUTING_DEEP_KEYWORDS=mimari,architecture,trade-off,trade off,multi-tenant,multi tenant,case study,implementasyon,production,ölçek,neden seç,karşılaştır,detaylı,recruiter,işe alım,backend mimar,rag , pipeline,tenant,postgresql,fastapi
# GROQ_CHAT_ROUTING_PROJECT_SHORT_MAX_CHARS=140
# GROQ_CHAT_ROUTING_DEEP_MIN_CHARS=140
# GROQ_CHAT_MAX_TOKENS=512
# GROQ_CHAT_MAX_HISTORY=12
# ADMIN_AI_ON_LOAD=false

# Tek komut: uv run site  (Reflex + Telegram bot)
# Sadece site: uv run site --no-bot
