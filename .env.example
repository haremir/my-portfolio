# ── LLM Providers ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_key_here
GROQ_API_KEY=your_groq_key_here

# LLM provider routing (active: deepseek, fallback: groq)
LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=groq
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek model presets
DEEPSEEK_CHAT_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_CHAT_MODEL_DEEP=deepseek-v4-pro
DEEPSEEK_ADMIN_MODEL=deepseek-v4-pro
DEEPSEEK_SUMMARY_MODEL=deepseek-v4-flash

# Groq fallback model presets
GROQ_CHAT_MODEL_FAST=llama-3.1-8b-instant
GROQ_CHAT_MODEL_DEEP=llama-3.3-70b-versatile
GROQ_ADMIN_MODEL=llama-3.1-8b-instant

# ── Security & Hot-Reload ───────────────────────────────────────────────────
ADMIN_PASSWORD=admin123
REFLEX_HOT_RELOAD_EXCLUDE_PATHS=data

# ── LLM Cost Controls & Caching ──────────────────────────────────────────────
GROQ_CHAT_ROUTING_DEEP_KEYWORDS=mimari,architecture,trade-off,trade off,multi-tenant,multi tenant,case study,implementasyon,production,ölçek,neden seç,karşılaştır,detaylı,recruiter,işe alım,backend mimar,rag , pipeline,tenant,postgresql,fastapi
GROQ_CHAT_ROUTING_PROJECT_SHORT_MAX_CHARS=140
GROQ_CHAT_ROUTING_DEEP_MIN_CHARS=140
GROQ_CHAT_MAX_TOKENS=512
# GROQ_CHAT_MAX_HISTORY=12
# LLM_CACHE_TTL_SECONDS=3600
# LLM_CACHE_MAX_ENTRIES=128
# ADMIN_AI_ON_LOAD=false

# ── Telegram Bot & Alerts ────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram user ID (get it from @userinfobot on Telegram)
TELEGRAM_ADMIN_ID=your_telegram_admin_id_here

# ── Notification thresholds (optional — these are the defaults) ─────────────
# HIRING_INTENT_COOLDOWN_MINUTES=60
# ERROR_ALERT_COOLDOWN_MINUTES=10
# WATCH_ALERT_COOLDOWN_MINUTES=30
# DAILY_SUMMARY_HOUR=21
# HEALTH_CHECK_HOURS=0
# INACTIVITY_PING_HOURS=0

# ── Reflex Cloud API (Telegram Bot → Reflex REST) ────────────────────────────
# Local dev: http://localhost:3000
# Production (Railway bot → Reflex Cloud): https://harun-site.reflex.run
REFLEX_API_URL=http://localhost:3000
# Secret for Bearer token auth on /api/* endpoints (set in Railway env vars)
TELEGRAM_API_SECRET=your_api_secret_here
# Set to true in LOCAL .env only — allows unauthenticated API access without a secret.
# NEVER set this in Railway/production. Defaults to false (secure by default).
# API_ALLOW_OPEN=true